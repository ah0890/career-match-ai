# CareerMatch AI configuration — copy to `.env` and adjust.
# Placeholder values only. Never commit a real `.env` file.

# Location of the local SQLite database (relative paths resolve from the project root).
CAREERMATCH_DATABASE_URL=sqlite:///data/careermatch.db

# Maximum accepted CV upload size in megabytes.
CAREERMATCH_MAX_UPLOAD_MB=5

# Recommendation thresholds (0-100). APPLY >= apply; APPLY AFTER IMPROVEMENT >= improve.
CAREERMATCH_THRESHOLD_APPLY=80
CAREERMATCH_THRESHOLD_IMPROVE=70

# Match-score weights in percent. They must be non-negative and sum to 100.
CAREERMATCH_WEIGHT_ATS=20
CAREERMATCH_WEIGHT_REQUIRED_SKILLS=25
CAREERMATCH_WEIGHT_EXPERIENCE=20
CAREERMATCH_WEIGHT_RESPONSIBILITIES=15
CAREERMATCH_WEIGHT_EDUCATION=10
CAREERMATCH_WEIGHT_KEYWORDS=10

# --- Job sources ---------------------------------------------------------
# Set to true to block every external request (CV analysis keeps working).
CAREERMATCH_OFFLINE_MODE=false
CAREERMATCH_HTTP_TIMEOUT_S=15

# Remotive (public API, no key). Limits are capped to respect Remotive's terms:
# at most 4 requests per day, feed reused for at least 6 hours.
CAREERMATCH_REMOTIVE_ENABLED=true
CAREERMATCH_REMOTIVE_DAILY_LIMIT=4
CAREERMATCH_REMOTIVE_CACHE_HOURS=6

# Himalayas, Jobicy and Remote OK (public APIs, no key)
CAREERMATCH_HIMALAYAS_ENABLED=true
CAREERMATCH_JOBICY_ENABLED=true
CAREERMATCH_REMOTEOK_ENABLED=true

# --- Backend API (accounts; used by the browser extension) ---------------
# Start with: python -m src.api   (interactive docs at http://127.0.0.1:8600/api/docs)
# Account data lives in its own database, separate from the single-user app.
CAREERMATCH_API_DATABASE_URL=sqlite:///data/careermatch_api.db
# Keep 127.0.0.1 unless you have read SECURITY.md (there is no HTTPS in local mode).
CAREERMATCH_API_HOST=127.0.0.1
CAREERMATCH_API_PORT=8600
CAREERMATCH_API_TOKEN_DAYS=30
CAREERMATCH_API_MAX_FAILED_LOGINS=5
CAREERMATCH_API_LOCKOUT_MINUTES=15
# Extra browser origins allowed to call the API (comma-separated). Chrome extensions are always allowed.
CAREERMATCH_API_CORS_ORIGINS=

# --- Application tracking & email --------------------------------------
# Days without any activity before an application shows as "No Response".
CAREERMATCH_TRACKER_NO_RESPONSE_DAYS=21
# Email tracking is optional and read-only. Use the credentials of YOUR OWN OAuth app
# registration (see README, "Email tracking"). Never commit real values.
CAREERMATCH_GMAIL_CLIENT_ID=
CAREERMATCH_GMAIL_CLIENT_SECRET=
CAREERMATCH_OUTLOOK_CLIENT_ID=
# Days of email history read on the first sync; minutes between automatic syncs (0 = manual only).
CAREERMATCH_MAIL_INITIAL_DAYS=60
CAREERMATCH_MAIL_AUTO_SYNC_MINUTES=30
CAREERMATCH_MAIL_MAX_PER_SYNC=300

# --- CV review & tailoring with Claude (optional) ------------------------
# Create a key at https://console.anthropic.com/settings/keys (usage is billed by Anthropic).
# Without a key the built-in rules still review and tailor your CV. With a key, CV text is sent
# to Anthropic only after you confirm it each time; contact details are removed first.
ANTHROPIC_API_KEY=
CAREERMATCH_CV_AI_ENABLED=true
CAREERMATCH_CV_AI_MODEL=claude-opus-5-5
